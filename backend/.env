# PostgreSQL connection (Render/Railway/Neon give you this as one string)
DATABASE_URL=postgresql://neondb_owner:npg_Evs5IVASTkB6@ep-rough-salad-aysl1h1c-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Set to true if your provider requires SSL (Render/Railway/Neon: true)
DATABASE_SSL=true

# Server
PORT=4000
NODE_ENV=production

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Optional: S3-compatible storage for image uploads (leave blank to disable
# the /api/admin/uploads/presign route — cover_image/images can still be
# plain URLs pasted in the admin panel without this)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
