# PostgreSQL connection (Render/Railway/Neon give you this as one string)
DATABASE_URL=postgresql://sudhanshu_user:WAE0k5oP20mABeMDjnyJy7uUIja0meNw@dpg-da3i10nlk1mc73fv7b90-a.singapore-postgres.render.com/sudhanshu
