# Server
PORT=4000
NODE_ENV=production

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://hidden-india-frontend.onrender.com

# Optional: S3-compatible storage for image uploads (leave blank to disable
# the /api/admin/uploads/presign route — cover_image/images can still be
# plain URLs pasted in the admin panel without this)
